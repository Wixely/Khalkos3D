<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rendering, verified against a real driver.

       SEPARATE FROM StannumFab.Tests ON PURPOSE. That suite needs no GPU and must run everywhere,
       including on a machine with no GL at all; this one needs a context and takes a windowing
       dependency to get one. Merging them would make the fast, portable suite unrunnable wherever
       the slow, driver-bound one cannot start.

       Silk.NET is MIT, and it is a TEST dependency - the shipped renderer still creates no window. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/StannumFab.Core/StannumFab.Core.csproj" />
    <ProjectReference Include="../../src/StannumFab.Formats/StannumFab.Formats.csproj" />
    <ProjectReference Include="../../src/StannumFab.Gl/StannumFab.Gl.csproj" />
  </ItemGroup>

</Project>
