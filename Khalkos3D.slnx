<Solution>
  <Folder Name="/src/">
    <Project Path="src/Khalkos3D.Core/Khalkos3D.Core.csproj" />
    <Project Path="src/Khalkos3D.Formats/Khalkos3D.Formats.csproj" />
    <Project Path="src/Khalkos3D.Gl/Khalkos3D.Gl.csproj" />
  </Folder>
  <!-- samples/Khalkos3D.AndroidDemo is deliberately ABSENT. Everything in this solution is built
       by the test job on three operating systems, and an android project makes that build demand
       the android workload on all of them or fail with NETSDK1147 before compiling a line. The
       Android app is built by its own CI job instead, which installs what it needs. -->
  <Folder Name="/samples/">
    <Project Path="samples/Khalkos3D.Demo/Khalkos3D.Demo.csproj" />
    <Project Path="samples/Khalkos3D.DesktopDemo/Khalkos3D.DesktopDemo.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Khalkos3D.Tests/Khalkos3D.Tests.csproj" />
    <Project Path="tests/Khalkos3D.RenderTests/Khalkos3D.RenderTests.csproj" />
  </Folder>
</Solution>
