<Project Sdk="Microsoft.NET.Sdk">

  <!-- The asset layer, in a browser tab.

       BOTH A DEMONSTRATION AND A GATE, the way the Android app is. The README claims these loaders
       run in a browser, and a claim about a target nobody builds for is one that stops being true
       quietly — a single BCL call with no wasm implementation is all it takes, and it would be found
       by a user rather than by us. CI publishes this project and asserts the assemblies really landed
       in the bundle; a person publishes it and looks at the page.

       Targeting net10.0-browser is the half that matters for the gate. It turns on the
       platform-compatibility analyser, so an API that browser does not support becomes CA1416 — an
       error here, since warnings are errors — instead of a runtime failure in someone's tab. The
       template the SDK ships targets plain net10.0 and loses that, which is why this is written out
       rather than generated.

       DELIBERATELY OUTSIDE Khalkos3D.slnx, like the Android app and for the same reason: everything
       in the solution is built by CI on three operating systems, and a project needing the wasm
       workload would make that build demand it on all three or fail before compiling a line. -->

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <!-- The generator behind [JSImport] emits unsafe marshalling code. Nothing in this sample is
         unsafe by hand, and nothing under src/ needs this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The page boots the runtime from here. Without it the publish produces a bundle with nothing
         to open, which is what this project used to be. -->
    <WasmMainJSPath>main.js</WasmMainJSPath>

    <!-- Mono's LLVM AOT is off by default and switched on from the command line — see the "Browser"
         entries in .vscode/launch.json. Both modes have to keep working: the plain one is what a
         browser app normally ships, and the LLVM one is where a BCL call the interpreter tolerates
         can still fail to compile. AOT happens on PUBLISH only; a build ignores the switch. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Khalkos3D.Formats/Khalkos3D.Formats.csproj" />
    <WasmExtraFilesToDeploy Include="index.html" />

    <!-- The same logo the desktop demo draws, so the page opens a real file rather than a fixture
         written to be easy. -->
    <EmbeddedResource Include="../../.github/assets/Khalkos3D.stl" LogicalName="Khalkos3D.BrowserDemo.Khalkos3D.stl" />
  </ItemGroup>

</Project>
