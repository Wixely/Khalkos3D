<Project Sdk="Microsoft.NET.Sdk">

  <!-- The model loaders: STL, OBJ, 3MF and glTF, all producing the same Scene.

       PURE MANAGED, ZERO DEPENDENCIES, AND THAT IS A REQUIREMENT RATHER THAN AN ACHIEVEMENT. This
       assembly compiles for browser-wasm, for Android and for iOS, where a native parser would mean
       a per-platform build matrix for something that is, in the end, reading bytes. Everything here
       needs is in the BCL: System.IO.Compression opens a 3MF (a zip), System.Text.Json reads a glTF,
       and the rest is arithmetic.

       The one thing genuinely NOT here is image decoding. PNG and JPEG belong to whoever already has
       a codec — Skia in a CupriFace app, ImageSharp elsewhere — so textures arrive through an
       IImageDecoder the caller supplies. Bundling a JPEG decoder to open a model would be the wrong
       trade for the many callers who already have one. -->

  <PropertyGroup>
    <Description>Model loaders for Khalkos3D: STL, OBJ, 3MF and glTF 2.0, all producing one Scene. Pure managed, no native dependencies, runs anywhere .NET does including WebAssembly.</Description>
    <PackageTags>3d;stl;obj;3mf;gltf;glb;mesh;loader;geometry</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Khalkos3D.Core/Khalkos3D.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Khalkos3D.Tests" />
  </ItemGroup>

</Project>
