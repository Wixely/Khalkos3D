<Project Sdk="Microsoft.NET.Sdk">

  <!-- The OpenGL backend.

       NO WINDOWING, NO CONTEXT CREATION, AND NO DEPENDENCIES. It is handed a proc-address function
       and draws into whatever framebuffer is bound. That is what lets one renderer serve a desktop
       window, an Android SurfaceView, a browser canvas and an offscreen target inside somebody
       else's UI toolkit — the founding requirement, since a renderer that owned its window would
       need a separate integration for each.

       GL 3.3 core on desktop and GLES 3.0 on mobile and the web are one API with two shader headers,
       and WebGL2 IS GLES 3.0 — so a phone and a browser compile the identical shader and only the
       desktop differs. Which of the two is decided by asking the driver, not by which platform this
       assembly was compiled for. -->

  <PropertyGroup>
    <Description>The OpenGL renderer for StannumFab: draws a Scene on desktop GL 3.3, OpenGL ES 3.0 and WebGL2 from one shader source. Creates no window and no context — hand it a proc-address function and it draws into whatever is bound, so it embeds anywhere.</Description>
    <PackageTags>3d;opengl;gl;webgl;gles;renderer;graphics;pbr</PackageTags>
    <!-- Function pointers: a GL entry-point table is what this is. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../StannumFab.Core/StannumFab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StannumFab.Tests" />
    <InternalsVisibleTo Include="StannumFab.RenderTests" />
  </ItemGroup>

</Project>
