<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine's vocabulary: meshes, materials, a scene graph, and the bounds and welding
       operations that every loader needs and none of them should reimplement.

       ZERO DEPENDENCIES, AND THAT IS THE POINT. Nothing here knows about a GPU, a window, a file
       format or an image codec. It is the layer every other project agrees on, so it must be the
       layer that compiles for every target — including browser-wasm, where a stray native
       dependency is not a warning but a link failure. -->

  <PropertyGroup>
    <Description>The Khalkos3D scene model: meshes, materials, nodes, bounds and mesh operations. No GPU, no file formats, no dependencies.</Description>
    <PackageTags>3d;mesh;scene;graphics;gltf;stl;engine</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Khalkos3D.Tests" />
  </ItemGroup>

</Project>
